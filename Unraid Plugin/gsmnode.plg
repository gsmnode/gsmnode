<?xml version='1.0' standalone='yes'?>

<!-- Built from "Unraid Plugin/source/" by scripts/build-plg.sh. Do not edit the
     generated gsmnode.plg by hand — edit this template, or the agent definition
     in gsmnode.xml, and build again. -->

<!DOCTYPE PLUGIN [
<!ENTITY name      "gsmnode">
<!ENTITY author    "FreeFallDev">
<!ENTITY version   "2026.07.24">
<!ENTITY launch    "Settings/Notifications">
<!ENTITY gitURL    "https://raw.githubusercontent.com/freefall-dev/gsmnode-unraid/main">
<!ENTITY pluginURL "&gitURL;/&name;.plg">
]>

<PLUGIN
  name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  min="6.10.0"
  icon="mobile"
  support="https://github.com/freefall-dev/gsmnode/issues">

<CHANGES>
##gsmnode

###2026.07.24
- First release. Adds a **gsmnode** notification agent, so Unraid notifications
  leave as SMS through an Android phone on a gsmnode gateway.
- Configure it under **Settings &#8594; Notifications &#8594; Notification Agents**,
  then tick **Agents** on the notification levels you want texted.
</CHANGES>


<!-- PRE-INSTALL: this plugin is a notification agent and nothing else, so there
     is no point installing it where the page that hosts one does not exist. -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
if [[ ! -d /usr/local/emhttp/plugins/dynamix/agents ]]; then
  echo
  echo "gsmnode needs Unraid's Notification Agents page, which this server does not have."
  echo "It arrived in Unraid 6.10. Upgrade, and install this again."
  echo
  exit 1
fi
if ! command -v jq >/dev/null; then
  echo
  echo "gsmnode needs jq to build what it sends, and this server does not have it."
  echo
  exit 1
fi
]]></INLINE>
</FILE>


<!-- INSTALL: unpack the agent definition and its icon onto the flash drive,
     then put them where the webGUI reads them.

     /usr/local/emhttp is a RAM disk and does not survive a reboot. Unraid
     reinstalls every plugin on the flash drive at boot, which runs this again
     and restores both copies — so the flash drive is the one that matters. -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
mkdir -p /boot/config/plugins/gsmnode

