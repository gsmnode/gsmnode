<!-- POST-INSTALL: say what to do next. An agent does nothing until it is filled
     in and switched on, and neither happens here. -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo
echo "-----------------------------------------------------------"
echo " gsmnode is installed."
echo
echo " Two things left, both in the webGUI:"
echo
echo " 1. Settings -> Notifications -> Notification Agents -> gsmnode"
echo "    Fill in the API Server, the account and who to text, set"
echo "    Agent function to Enabled, and Apply. Then press Test."
echo
echo " 2. Settings -> Notifications -> Notification Settings"
echo "    Tick Agents on the notification levels you want texted."
echo
echo " Apache License 2.0 - https://github.com/freefall-dev/gsmnode"
echo "-----------------------------------------------------------"
echo
]]></INLINE>
</FILE>


<!-- REMOVE: take the configured agent too. It is a self-contained script that
     holds the account password and would keep sending texts after the plugin
     that explains it is gone. -->
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
rm -f /usr/local/emhttp/plugins/dynamix/agents/gsmnode.xml
rm -f /usr/local/emhttp/plugins/dynamix/icons/gsmnode.png
rm -f /boot/config/plugins/dynamix/notifications/agents/gsmnode.sh
rm -f /boot/config/plugins/dynamix/notifications/agents-disabled/gsmnode.sh
rm -rf /boot/config/plugins/gsmnode
rm -f /boot/config/plugins/gsmnode.plg

echo
echo "gsmnode is removed, and so are the agent and the account it was told to send as."
echo
]]></INLINE>
</FILE>

</PLUGIN>
