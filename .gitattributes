# Shell scripts must keep LF endings — they run inside Linux containers, where
# CRLF would break the shebang and `set -e` parsing.
*.sh text eol=lf

# Docker entrypoints / configs consumed by Linux tooling.
Dockerfile text eol=lf
.dockerignore text eol=lf

# Unraid plugins. The .plg carries shell blocks bash runs on the server, so a CR
# would end up in something Unraid executes. The rest of that folder's rules are
# in "Unraid Plugin/.gitattributes", so they travel with it when it is split out.
*.plg text eol=lf
